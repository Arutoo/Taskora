{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/jobs/check-overdue",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/jobs/deadline-reminders",
      "schedule": "0 0 * * *"
    }
  ]
}
