DATABASE_URL=postgresql://user:pass@localhost:5432/taskora

JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development 

# NODE_ENV can be 'development' or 'production'. Make sure to set it to 'production' when deploying.
# 'development' == Prisma log error + warn; cookie secure: false (HTTP ok)
# 'production' == Prisma log error only; cookie secure: true (HTTPS only); Prisma client not cached to global

CRON_SECRET=your_cron_secret_here

SOCKET_SERVER_URL=
SOCKET_INTERNAL_SECRET=your_socket_internal_secret_here

BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Taskora
#get Brevo API key from https://app.brevo.com/settings/keys/api


